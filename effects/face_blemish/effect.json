{
  "id": "face_blemish",
  "version": "1.0.0",
  "displayName": "Blemish Removal",
  "category": "beauty",
  "description": "Evens out spots, pimples and fine wrinkles on the skin of the tracked face, keeping pores and features.",
  "order": 701,
  "requires": "face",
  "parameters": [
    {
      "identifier": "spots",
      "displayName": "Spots",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.7
    },
    {
      "identifier": "wrinkles",
      "displayName": "Wrinkles",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.4
    },
    {
      "identifier": "faceIndex",
      "displayName": "Face",
      "type": "float",
      "minValue": 0,
      "maxValue": 3,
      "defaultValue": 0
    }
  ],
  "backend": "gpu",
  "pipeline": {
    "intermediateBuffers": [
      {
        "id": "spot_h",
        "scale": 0.5
      },
      {
        "id": "spot_mean",
        "scale": 0.5
      }
    ],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "mean_h.frag",
        "inputs": [
          {
            "type": "source_texture"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "spot_h"
        }
      },
      {
        "passIndex": 1,
        "fragmentShader": "mean_v.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "spot_h"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "spot_mean"
        }
      },
      {
        "passIndex": 2,
        "fragmentShader": "blemish.frag",
        "inputs": [
          {
            "type": "source_texture"
          },
          {
            "type": "buffer",
            "id": "spot_mean"
          }
        ],
        "output": {
          "type": "canvas"
        }
      }
    ]
  }
}
