{
 "format": 1,
 "id": "ibs-skew-snap",
 "label": "Skew snap",
 "category": "stylized",
 "sampleText": "SNAP TO IT",
 "slots": [
  "in"
 ],
 "order": 2026,
 "defaults": {
  "unit": "word",
  "stagger": 0.14,
  "duration": 0.45,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.2,
       2.1
      ],
      "c2": [
       0.45,
       1.0
      ]
     }
    }
   ],
   "props": {
    "skew": -55,
    "scaleY": 30,
    "position": {
     "x": -0.3,
     "y": 0,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 300000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
