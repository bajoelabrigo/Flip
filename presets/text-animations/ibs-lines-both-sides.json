{
 "format": 1,
 "id": "ibs-lines-both-sides",
 "label": "Lines from both sides",
 "category": "build",
 "sampleText": "LINE ONE\nLINE TWO",
 "slots": [
  "in"
 ],
 "order": 2006,
 "defaults": {
  "unit": "line",
  "stagger": 0.18,
  "duration": 0.55,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "unitLocked": true,
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.16,
       1.0
      ],
      "c2": [
       0.3,
       1.0
      ]
     }
    },
    {
     "driver": "wiggle",
     "domain": "line",
     "wave": "sine",
     "frequencyHz": 0,
     "spatialPhaseDeg": 180,
     "minAmount": -100,
     "maxAmount": 100,
     "temporalPhaseDeg": 90,
     "mode": "intersect"
    }
   ],
   "props": {
    "position": {
     "x": 1.4,
     "y": 0,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.16,
       1.0
      ],
      "c2": [
       0.3,
       1.0
      ]
     }
    }
   ],
   "props": {
    "blur": 8
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 400000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
