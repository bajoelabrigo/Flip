{
 "format": 1,
 "id": "ibs-staircase",
 "label": "Staircase rise",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2008,
 "defaults": {
  "unit": "character",
  "stagger": 0.07,
  "duration": 0.45,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "unitLocked": true,
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.05,
       0.9
      ],
      "c2": [
       0.1,
       1.0
      ]
     }
    }
   ],
   "props": {
    "position": {
     "x": 0,
     "y": 0.3,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.05,
       0.9
      ],
      "c2": [
       0.1,
       1.0
      ]
     }
    },
    {
     "driver": "curves",
     "domain": "character",
     "units": "percent",
     "shape": "rampUp",
     "start": 0.0,
     "end": 100.0,
     "mode": "intersect"
    }
   ],
   "props": {
    "position": {
     "x": 0,
     "y": 1.5,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 400000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
