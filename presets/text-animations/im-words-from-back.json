{
 "format": 1,
 "id": "im-words-from-back",
 "label": "Words from far away",
 "category": "motion",
 "sampleText": "GO BIG NOW",
 "slots": [
  "in"
 ],
 "order": 2129,
 "defaults": {
  "unit": "word",
  "stagger": 0.1,
  "duration": 0.6,
  "ease": "easeOut",
  "order": "random"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.16,
       1.0
      ],
      "c2": [
       0.3,
       1.0
      ]
     }
    }
   ],
   "props": {
    "scale": 12,
    "blur": 10
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 400000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
