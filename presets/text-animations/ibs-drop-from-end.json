{
 "format": 1,
 "id": "ibs-drop-from-end",
 "label": "Drop from the end",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2007,
 "defaults": {
  "unit": "character",
  "stagger": 0.07,
  "duration": 0.55,
  "ease": "bounce",
  "order": "backward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "position": {
     "x": 0,
     "y": -1.4,
     "unit": "em"
    },
    "rotation": 15
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 300000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
