  "in"
 ],
 "order": 2029,
 "defaults": {
  "unit": "character",
  "stagger": 0.05,
  "duration": 0.7,
  "ease": "smooth",
  "order": "forward"
 },
 "flags": {
  "unitLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
