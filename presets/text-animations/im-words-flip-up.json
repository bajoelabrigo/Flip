{
 "format": 1,
 "id": "im-words-flip-up",
 "label": "Words flip up",
 "category": "motion",
 "sampleText": "GO BIG NOW",
 "slots": [
  "in"
 ],
 "order": 2139,
 "defaults": {
  "unit": "word",
  "stagger": 0.1,
  "duration": 0.45,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
