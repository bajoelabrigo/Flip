{
 "format": 1,
 "id": "im-bounce-drop",
 "label": "Letters drop and bounce",
 "category": "motion",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2113,
 "defaults": {
  "unit": "character",
  "stagger": 0.07,
  "duration": 0.7,
  "ease": "bounce",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "position": {
     "x": 0,
     "y": -2.6,
     "unit": "em"
    },
    "scaleY": 130
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 200000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
