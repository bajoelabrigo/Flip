{
 "format": 1,
 "id": "ibs-chromatic-pop",
 "label": "Chromatic pop",
 "category": "stylized",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2021,
 "defaults": {
  "unit": "character",
  "stagger": 0.06,
  "duration": 0.35,
  "ease": "back",
  "order": "centerOut"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "scale": 160
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1800000.0
     },
     "ease": "easeOut"
    }
   ],
   "props": {
    "fillColor": "#ff22e4ff"
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 900000.0
     },
     "ease": "easeOut"
    }
   ],
   "props": {
    "fillColor": "#ffff2bd6"
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 300000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
