{
 "format": 1,
 "id": "om-bouncy-shrink",
 "label": "Bouncy shrink",
 "category": "fluid",
 "sampleText": "ABCD",
 "slots": [
  "out"
 ],
 "order": 2251,
 "defaults": {
  "unit": "character",
  "stagger": 0.05,
  "duration": 0.6,
  "ease": "bounce",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "scale": 0
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 200000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
