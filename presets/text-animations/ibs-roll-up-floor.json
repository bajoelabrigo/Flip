{
 "format": 1,
 "id": "ibs-roll-up-floor",
 "label": "Roll up from the floor",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2016,
 "defaults": {
  "unit": "character",
  "stagger": 0.06,
  "duration": 0.5,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.16,
       1.0
      ],
      "c2": [
       0.3,
       1.0
      ]
     }
    }
   ],
   "props": {
    "rotationX": 90,
    "position": {
     "x": 0,
     "y": 0.25,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 400000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
