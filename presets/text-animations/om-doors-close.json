{
 "format": 1,
 "id": "om-doors-close",
 "label": "Doors close by word",
 "category": "mask",
 "sampleText": "SEE YOU SOON",
 "slots": [
  "out"
 ],
 "order": 2230,
 "defaults": {
  "unit": "word",
  "stagger": 0.12,
  "duration": 0.45,
  "ease": "easeOut",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "rotationY": 90,
    "position": {
     "x": -0.15,
     "y": 0,
     "unit": "em"
    },
    "fillColor": "#ff5a5a5a"
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 300000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
