{
 "format": 1,
 "id": "im-stretch-rise-lines",
 "label": "Stretched rise by line",
 "category": "motion",
 "sampleText": "NEW\nDROP",
 "slots": [
  "in"
 ],
 "order": 2114,
 "defaults": {
  "unit": "line",
  "stagger": 0.12,
  "duration": 0.5,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.25,
       0.1
      ],
      "c2": [
       0.25,
       1.0
      ]
     }
    }
   ],
   "props": {
    "position": {
     "x": 0,
     "y": 1.3,
     "unit": "em"
    },
    "scaleY": 150,
    "blur": 8
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 400000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
