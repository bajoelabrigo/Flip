{
 "format": 1,
 "id": "ic-dot-bounce",
 "label": "Bouncing dot cursor",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2065,
 "defaults": {
  "unit": "character",
  "stagger": 0.09,
  "duration": 0.3,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "params": [
  {
   "id": "caret",
   "type": "bool",
   "label": "Caret",
   "default": true
  },
  {
   "id": "lead",
   "type": "scalar",
   "label": "Caret lead",
   "unit": "s",
   "min": 0,
   "max": 2,
   "step": 0.05,
   "default": 0.3
  },
  {
   "id": "hold",
   "type": "scalar",
   "label": "Hold after",
   "unit": "s",
   "min": 0,
   "max": 5,
   "step": 0.1,
   "default": 0.6
  }
 ],
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.2,
       2.1
      ],
      "c2": [
       0.45,
       1.0
      ]
     }
    }
   ],
   "props": {
    "position": {
     "x": 0,
     "y": 0.35,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 200000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ],
 "caret": {
  "enabled": "{caret}",
  "leadUs": {
   "$": "lead",
   "mul": 1000000
  },
  "holdAfterUs": {
   "$": "hold",
   "mul": 1000000
  },
  "shape": "glyph",
  "glyph": "shape:circle",
  "heightEm": 0.35,
  "gapEm": 0.1,
  "blinkOnUs": 220000,
  "blinkOffUs": 0,
  "color": "#ffff5a36",
  "bobEm": 0.12,
  "swayHz": 3.0
 }
}
