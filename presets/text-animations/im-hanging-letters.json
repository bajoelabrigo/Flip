{
 "format": 1,
 "id": "im-hanging-letters",
 "label": "Hanging letters swing in",
 "category": "motion",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2125,
 "defaults": {
  "unit": "character",
  "stagger": 0.06,
  "duration": 0.7,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.25,
       1.8
      ],
      "c2": [
       0.4,
       1.0
      ]
     }
    }
   ],
   "props": {
    "position": {
     "x": 0.35,
     "y": -0.35,
     "unit": "em"
    },
    "rotation": 70
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 250000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
