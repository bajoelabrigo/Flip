{
 "format": 1,
 "id": "om-lean-fold",
 "label": "Lean and fold",
 "category": "stylized",
 "sampleText": "ABCD",
 "slots": [
  "out"
 ],
 "order": 2257,
 "defaults": {
  "unit": "character",
  "stagger": 0.05,
  "duration": 0.35,
  "ease": "easeOut",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "skew": 60,
    "scaleX": 20
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 400000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
