{
 "format": 1,
 "id": "ibs-glow-bloom",
 "label": "Glow bloom",
 "category": "stylized",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2023,
 "defaults": {
  "unit": "character",
  "stagger": 0.05,
  "duration": 0.7,
  "ease": "easeOut",
  "order": "centerOut"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "blur": 16,
    "scale": 125
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 600000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1300000.0
     },
     "ease": "easeOut"
    }
   ],
   "props": {
    "fillColor": "#ffffe08a",
    "strokeColor": "#ffffd27a",
    "strokeWidth": 6
   }
  }
 ]
}
