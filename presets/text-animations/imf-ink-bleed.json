{
 "format": 1,
 "id": "imf-ink-bleed",
 "label": "Soft ink bleed",
 "category": "mask",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2088,
 "defaults": {
  "unit": "character",
  "stagger": 0.09,
  "duration": 0.7,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.25,
       0.1
      ],
      "c2": [
       0.25,
       1.0
      ]
     }
    }
   ],
   "props": {
    "wipe": {
     "enabled": true,
     "angleDeg": 0,
     "softness": 1.0
    },
    "blur": 10,
    "strokeWidth": 4
   }
  }
 ]
}
