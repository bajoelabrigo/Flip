{
  "format": 1,
  "id": "glow-pulse",
  "label": "Glow pulse",
  "category": "basic",
  "sampleText": "Glow",
  "slots": [
    "loop"
  ],
  "order": 496,
  "params": [
    {
      "id": "radius",
      "type": "scalar",
      "label": "Glow",
      "unit": "px",
      "min": 2,
      "max": 80,
      "step": 1,
      "default": 22
    },
    {
      "id": "base",
      "type": "scalar",
      "label": "Resting glow",
      "unit": "px",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 4
    },
    {
      "id": "period",
      "type": "scalar",
      "label": "Period",
      "unit": "s",
      "min": 0.2,
      "max": 10,
      "step": 0.1,
      "default": 1.5
    }
  ],
  "animators": [
    {
      "selectors": [],
      "props": {
        "glow": {
          "value": 0,
          "curve": {
            "interpolation": "easeInOut",
            "keyframes": [
              {
                "timeUs": 0,
                "value": "{base}"
              },
              {
                "timeUs": 500000,
                "value": "{radius}"
              },
              {
                "timeUs": 1000000,
                "value": "{base}"
              }
            ]
          }
        }
      }
    }
  ]
}
