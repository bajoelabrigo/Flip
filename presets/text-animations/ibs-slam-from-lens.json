{
 "format": 1,
 "id": "ibs-slam-from-lens",
 "label": "Slam from the lens",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2017,
 "defaults": {
  "unit": "character",
  "stagger": 0.06,
  "duration": 0.38,
  "ease": "easeOut",
  "order": "random"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "scale": 420,
    "blur": 12
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 600000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
