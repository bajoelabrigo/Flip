{
 "format": 1,
 "id": "ibs-ink-blot",
 "label": "Ink blot settle",
 "category": "stylized",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2032,
 "defaults": {
  "unit": "character",
  "stagger": 0.07,
  "duration": 0.6,
  "ease": "smooth",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "blur": 10,
    "strokeWidth": 14,
    "strokeColor": "#ff101014",
    "scale": 115
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": "{ease}"
    }
   ],
   "props": {
    "fillColor": "#ff1a1a22"
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 500000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
