{
 "format": 1,
 "id": "imf-colour-through",
 "label": "Fade through colour",
 "category": "mask",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2080,
 "defaults": {
  "unit": "character",
  "stagger": 0.07,
  "duration": 0.55,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.25,
       0.1
      ],
      "c2": [
       0.25,
       1.0
      ]
     }
    }
   ],
   "props": {
    "fillColor": "#ffffd84a",
    "strokeColor": "#ffff8a00",
    "blur": 6
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 300000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
