{
 "format": 1,
 "id": "imf-venetian-lines",
 "label": "Venetian blinds",
 "category": "mask",
 "sampleText": "BIG\nNEWS",
 "slots": [
  "in"
 ],
 "order": 2075,
 "defaults": {
  "unit": "line",
  "stagger": 0.14,
  "duration": 0.45,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.05,
       0.9
      ],
      "c2": [
       0.1,
       1.0
      ]
     }
    }
   ],
   "props": {
    "wipe": {
     "enabled": true,
     "angleDeg": 90,
     "softness": 0.1
    },
    "scaleY": 0
   }
  }
 ]
}
