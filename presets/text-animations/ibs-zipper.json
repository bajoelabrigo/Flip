{
 "format": 1,
 "id": "ibs-zipper",
 "label": "Zipper",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2013,
 "defaults": {
  "unit": "character",
  "stagger": 0.045,
  "duration": 0.45,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "unitLocked": true,
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.05,
       0.9
      ],
      "c2": [
       0.1,
       1.0
      ]
     }
    },
    {
     "driver": "wiggle",
     "domain": "character",
     "wave": "sine",
     "frequencyHz": 0,
     "spatialPhaseDeg": 180,
     "minAmount": -100,
     "maxAmount": 100,
     "temporalPhaseDeg": 90,
     "mode": "intersect"
    }
   ],
   "props": {
    "position": {
     "x": 0,
     "y": 1.1,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 350000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
