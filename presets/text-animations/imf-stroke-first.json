{
 "format": 1,
 "id": "imf-stroke-first",
 "label": "Stroke-first letters",
 "category": "mask",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2081,
 "defaults": {
  "unit": "character",
  "stagger": 0.08,
  "duration": 0.6,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
