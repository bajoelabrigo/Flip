{
 "format": 1,
 "id": "om-roll-left",
 "label": "Roll away left",
 "category": "motion",
 "sampleText": "ABCD",
 "slots": [
  "out"
 ],
 "order": 2223,
 "defaults": {
  "unit": "character",
  "stagger": 0.05,
  "duration": 0.6,
  "ease": "easeOut",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "position": {
     "x": -2.4,
     "y": 0,
     "unit": "em"
    },
    "rotation": -360
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 350000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
