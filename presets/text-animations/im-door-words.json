     "ease": {
      "kind": "bezier",
      "c1": [
       0.25,
       0.1
      ],
      "c2": [
       0.25,
       1.0
      ]
     }
    }
   ],
   "props": {
    "rotationY": -95
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 300000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
