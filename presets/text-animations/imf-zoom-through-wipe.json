{
 "format": 1,
 "id": "imf-zoom-through-wipe",
 "label": "Zoom-through wipe",
 "category": "mask",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2083,
 "defaults": {
  "unit": "block",
  "stagger": 0.05,
  "duration": 0.65,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "unitLocked": true,
  "orderLocked": true,
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.16,
       1.0
      ],
      "c2": [
       0.3,
       1.0
      ]
     }
    }
   ],
   "props": {
    "scale": 150,
    "wipe": {
     "enabled": true,
     "angleDeg": 90,
     "softness": 0.7
    },
    "blur": 8
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 400000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
