{
 "format": 1,
 "id": "ibs-outline-then-fill",
 "label": "Outline then fill",
 "category": "stylized",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2025,
 "defaults": {
  "unit": "character",
  "stagger": 0.1,
  "duration": 0.35,
  "ease": "easeOut",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 500000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  },
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "strokeWidth": 7,
    "strokeColor": "#ffffffff"
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 2200000.0
     },
     "ease": "easeIn"
    }
   ],
   "props": {
    "fillOpacity": 0
   }
  }
 ]
}
