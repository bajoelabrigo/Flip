{
 "format": 1,
 "id": "imf-melt-in",
 "label": "Melt into shape",
 "category": "fluid",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2099,
 "defaults": {
  "unit": "character",
  "stagger": 0.07,
  "duration": 0.8,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.25,
       0.1
      ],
      "c2": [
       0.25,
       1.0
      ]
     }
    }
   ],
   "props": {
    "scaleY": 40,
    "scaleX": 125,
    "blur": 18,
    "position": {
     "x": 0,
     "y": 0.25,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 500000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
