{
 "format": 1,
 "id": "im-card-turn",
 "label": "Card turn",
 "category": "motion",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2137,
 "defaults": {
  "unit": "character",
  "stagger": 0.08,
  "duration": 0.55,
  "ease": "smooth",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "rotationY": 180,
    "scale": 85
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 550000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
