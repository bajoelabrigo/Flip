{
 "format": 1,
 "id": "imf-gooey-merge",
 "label": "Gooey merge",
 "category": "fluid",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2100,
 "defaults": {
  "unit": "block",
  "stagger": 0.05,
  "duration": 0.75,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "unitLocked": true,
  "orderLocked": true,
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.2,
       2.1
      ],
      "c2": [
       0.45,
       1.0
      ]
     }
    }
   ],
   "props": {
    "tracking": 0.9,
    "trackingUnit": "em",
    "blur": 12,
    "scaleY": 130
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 350000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
