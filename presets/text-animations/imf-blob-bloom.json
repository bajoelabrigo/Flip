{
 "format": 1,
 "id": "imf-blob-bloom",
 "label": "Blob bloom",
 "category": "fluid",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2105,
 "defaults": {
  "unit": "character",
  "stagger": 0.05,
  "duration": 0.55,
  "ease": "back",
  "order": "centerOut"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "scaleX": 0,
    "scaleY": 160,
    "blur": 22
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 300000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
