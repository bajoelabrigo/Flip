       1.0
      ]
     }
    }
   ],
   "props": {
    "position": {
     "x": 3.0,
     "y": 0,
     "unit": "em"
    },
    "skew": -32,
    "blur": 6
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 300000.0
     },
     "ease": "linear"
    }
   ],
