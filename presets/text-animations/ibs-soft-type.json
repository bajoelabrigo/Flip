{
 "format": 1,
 "id": "ibs-soft-type",
 "label": "Soft-fade typing",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2011,
 "defaults": {
  "unit": "character",
  "stagger": 0.08,
  "duration": 0.22,
  "ease": "linear",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "params": [
  {
   "id": "caret",
   "type": "bool",
   "label": "Caret",
   "default": true
  },
  {
   "id": "lead",
   "type": "scalar",
   "label": "Caret lead",
   "unit": "s",
   "min": 0,
   "max": 2,
   "step": 0.05,
   "default": 0.3
  },
  {
   "id": "hold",
   "type": "scalar",
   "label": "Hold after",
   "unit": "s",
   "min": 0,
   "max": 5,
   "step": 0.1,
   "default": 0.6
  }
 ],
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "position": {
     "x": -0.12,
     "y": 0,
     "unit": "em"
    },
    "opacity": 0
   }
  }
 ],
 "caret": {
  "enabled": "{caret}",
  "leadUs": {
   "$": "lead",
   "mul": 1000000
  },
  "blinkOnUs": 220000,
  "blinkOffUs": 280000,
  "holdAfterUs": {
   "$": "hold",
   "mul": 1000000
  },
  "widthEm": 0.08,
  "heightEm": 1.0,
  "shape": "bar",
  "color": ""
 }
}
