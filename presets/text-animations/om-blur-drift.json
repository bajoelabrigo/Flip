{
 "format": 1,
 "id": "om-blur-drift",
 "label": "Blur and drift",
 "category": "fluid",
 "sampleText": "ABCD",
 "slots": [
  "out"
 ],
 "order": 2244,
 "defaults": {
  "unit": "character",
  "stagger": 0.05,
  "duration": 0.6,
  "ease": "smooth",
  "order": "random"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "blur": 20,
    "position": {
     "x": 0.4,
     "y": -0.25,
     "unit": "em"
    },
    "scale": 120
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 800000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
