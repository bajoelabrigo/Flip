{
 "format": 1,
 "id": "ic-underscore-blur",
 "label": "Underscore typing with focus",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2040,
 "defaults": {
  "unit": "character",
  "stagger": 0.09,
  "duration": 0.25,
  "ease": "easeOut",
  "order": "forward"
 },
 "params": [
  {
   "id": "caret",
   "type": "bool",
   "label": "Caret",
   "default": true
  },
  {
   "id": "lead",
   "type": "scalar",
   "label": "Caret lead",
   "unit": "s",
   "min": 0,
   "max": 2,
   "step": 0.05,
   "default": 0.3
  },
  {
   "id": "hold",
   "type": "scalar",
   "label": "Hold after",
   "unit": "s",
   "min": 0,
   "max": 5,
   "step": 0.1,
   "default": 0.6
  }
 ],
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "blur": 14
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 200000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ],
 "caret": {
  "enabled": "{caret}",
  "leadUs": {
   "$": "lead",
   "mul": 1000000
  },
  "blinkOnUs": 220000,
  "blinkOffUs": 280000,
  "holdAfterUs": {
   "$": "hold",
   "mul": 1000000
  },
  "widthEm": 0.6,
  "heightEm": 0.1,
  "shape": "underscore",
  "color": "#ffffffff"
 }
}
