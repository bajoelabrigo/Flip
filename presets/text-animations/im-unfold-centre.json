{
 "format": 1,
 "id": "im-unfold-centre",
 "label": "Unfold from the centre",
 "category": "motion",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2132,
 "defaults": {
  "unit": "character",
  "stagger": 0.03,
  "duration": 0.55,
  "ease": "back",
  "order": "centerOut"
 },
 "animators": [
  {
   "selectors": [
