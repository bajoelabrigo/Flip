{
 "format": 1,
 "id": "om-flip-back-3d",
 "label": "3D flip backwards",
 "category": "build",
 "sampleText": "ABCD",
 "slots": [
  "out"
 ],
 "order": 2241,
 "defaults": {
  "unit": "character",
  "stagger": 0.06,
  "duration": 0.4,
  "ease": "easeOut",
  "order": "forward"
 },
 "animators": [
  {
   "selectors": [
    "stagger"
   ],
   "props": {
    "rotationX": 95,
    "position": {
     "x": 0,
     "y": -0.15,
     "unit": "em"
    }
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 500000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
