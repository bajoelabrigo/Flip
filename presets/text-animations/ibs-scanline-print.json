     "durationUs": {
      "$": "duration",
      "mul": 2000000.0
     },
     "ease": "easeOut"
    }
   ],
   "props": {
    "fillColor": "#ff5ef2ff"
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": "{ease}"
    },
    {
     "driver": "wiggle",
     "domain": "character",
     "wave": "noise",
     "frequencyHz": 20,
     "spatialPhaseDeg": 97,
     "minAmount": -100,
     "maxAmount": 100,
     "seed": 2,
     "mode": "intersect"
