{
 "format": 1,
 "id": "im-flip-over",
 "label": "Full letter flip",
 "category": "motion",
 "sampleText": "ABCD",
 "slots": [
  "in"
 ],
 "order": 2135,
 "defaults": {
  "unit": "character",
  "stagger": 0.07,
  "duration": 0.6,
  "ease": "easeOut",
  "order": "forward"
 },
 "flags": {
  "easeLocked": true
 },
 "animators": [
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 1000000.0
     },
     "ease": {
      "kind": "bezier",
      "c1": [
       0.16,
       1.0
      ],
      "c2": [
       0.3,
       1.0
      ]
     }
    }
   ],
   "props": {
    "rotationX": -180
   }
  },
  {
   "selectors": [
    {
     "driver": "stagger",
     "domain": "{unit}",
     "order": "{order}",
     "staggerUs": {
      "$": "stagger",
      "mul": 1000000.0
     },
     "durationUs": {
      "$": "duration",
      "mul": 500000.0
     },
     "ease": "linear"
    }
   ],
   "props": {
    "opacity": 0
   }
  }
 ]
}
